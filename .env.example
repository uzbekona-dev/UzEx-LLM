# --- LLM chain (tried in order; a model is retried RETRIES_PER_MODEL times, then the next one) ---
# Entries are provider:model; providers: gemini, anthropic, openai. A bare name means gemini.
LLM_MODELS=gemini:gemini-3.5-flash,gemini:gemini-flash-latest,anthropic:claude-sonnet-5-5,openai:gpt-5-mini
# Legacy fallback used only when LLM_MODELS is unset (comma-separated Gemini model names).
GEMINI_MODEL=gemini-3.5-flash,gemini-flash-latest,gemini-3.8-flash,gemini-2.5-flash
# Attempts per chain entry before moving to the next one (default 2).
RETRIES_PER_MODEL=2

# --- Vendor keys: chain entries whose key is empty are skipped (at least one must be set) ---
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional: point the openai provider at any OpenAI-compatible endpoint (Groq, Ollama, OpenRouter...).
OPENAI_BASE_URL=

TELEGRAM_BOT_TOKEN=
DB_PATH=data/uzex.db

# Answer time budget: no new LLM call is started after this many seconds (each call times out at 40 s)
ANSWER_BUDGET_SEC=45
# Every answered question is appended here as one JSON line (empty = disabled)
QA_LOG=logs/qa.jsonl

# Second LLM call that reviews the SQL logic against the rules (1 = on, 0 = off; +3-5 s per question)
SQL_CRITIC=1

# Gemini thinking level for the planner and the SQL critic: low (fast, default) | minimal | medium | high | default | 0
PLAN_THINKING=low
CRITIC_THINKING=low
