# systemd unit for the UZEX Telegram bot.
#
# Install (paths assume the repo is cloned to /opt/uzex-bot and a venv exists there):
#   sudo useradd --system --home /opt/uzex-bot --shell /usr/sbin/nologin uzex   # once
#   sudo chown -R uzex:uzex /opt/uzex-bot
#   sudo cp deploy/uzex-bot.service /etc/systemd/system/uzex-bot.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now uzex-bot
#   sudo systemctl status uzex-bot
#   journalctl -u uzex-bot -f
#
# .env must contain TELEGRAM_BOT_TOKEN and at least one LLM key (no quotes, no `export`).

[Unit]
Description=UZEX exchange-deals Telegram bot (aiogram, long polling)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=uzex
Group=uzex
WorkingDirectory=/opt/uzex-bot
EnvironmentFile=/opt/uzex-bot/.env
Environment=PYTHONIOENCODING=utf-8
Environment=PYTHONUNBUFFERED=1
Environment=DB_PATH=data/uzex.db
Environment=QA_LOG=logs/qa.jsonl
ExecStartPre=/bin/mkdir -p /opt/uzex-bot/logs
ExecStart=/opt/uzex-bot/.venv/bin/python -X utf8 bot.py
Restart=always
RestartSec=5
# Telegram polling can hang on a dead socket; let systemd kill a stuck stop quickly.
TimeoutStopSec=20
KillSignal=SIGINT
# Hardening (the bot only needs to read data/ and write logs/)
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/uzex-bot/logs

[Install]
WantedBy=multi-user.target
