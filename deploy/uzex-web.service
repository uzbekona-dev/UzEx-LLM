# systemd unit for the UZEX web UI (FastAPI + uvicorn), same code and data as the Telegram bot.
#
# Install (paths assume the repo is cloned to /opt/uzex-bot and a venv exists there):
#   sudo cp deploy/uzex-web.service /etc/systemd/system/uzex-web.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now uzex-web
#   sudo systemctl status uzex-web
#   journalctl -u uzex-web -f
#   curl http://localhost:8080/api/health
#
# .env must contain at least one LLM key (TELEGRAM_BOT_TOKEN is not needed for the web UI).
# Put a reverse proxy with TLS (nginx / caddy) in front if the page is exposed to the internet.

[Unit]
Description=UZEX exchange-deals web UI (FastAPI, uvicorn :8080)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=uzex
Group=uzex
WorkingDirectory=/opt/uzex-bot
EnvironmentFile=/opt/uzex-bot/.env
Environment=PYTHONIOENCODING=utf-8
Environment=PYTHONUNBUFFERED=1
Environment=DB_PATH=data/uzex.db
Environment=QA_LOG=logs/qa.jsonl
ExecStartPre=/bin/mkdir -p /opt/uzex-bot/logs
ExecStart=/opt/uzex-bot/.venv/bin/python -X utf8 -m uvicorn web:app --host 0.0.0.0 --port 8080
Restart=always
RestartSec=5
TimeoutStopSec=20
KillSignal=SIGINT
# Hardening (the server only needs to read data/ and write logs/)
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/uzex-bot/logs

[Install]
WantedBy=multi-user.target
